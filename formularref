% For Equation (25) - Elongation Index:
The Elongation Index (EI) is defined as~\cite{Zhang2020}:
\begin{equation}
{EI} = \frac{d_S}{d_I}
\label{eq:elongation}
\end{equation}

% For Equation (26) - Flatness Index:
The Flatness Index (FI) is calculated as~\cite{Clayton2009}:
\begin{equation}
{FI} = \frac{d_I}{d_L}
\label{eq:flatness}
\end{equation}

% For Equation (27) - Aspect Ratio:
The Aspect Ratio is given by~\cite{Cho2006}:
\begin{equation}
{\text{Aspect Ratio}} = \frac{d_S}{d_L}
\label{eq:aspectratio}
\end{equation}

% For Equation (28) - Convexity Index:
The convexity index (CI) is defined as~\cite{Cox2008}:
\begin{equation}
{CI} = \frac{V_{P}}{V_{C}}
\label{eq:convexity}
\end{equation}

% For Equation (29) - Circularity:
The circularity (CR) is computed as~\cite{Cox1927}:
\begin{equation}
{CR} = \frac{A_{P}}{A_E}
\label{eq:circularity}
\end{equation}

% For Equation (30) - Wadell’s sphericity:
Wadell’s sphericity is defined as~\cite{Wadell1935}:
\begin{equation}
{\Psi_{Wadell}} = \frac{S_E}{S_P}
\label{eq:sphericity_wadell}
\end{equation}

% For Equation (31) - Elliptical volume sphericity:
The elliptical volume sphericity is calculated as~\cite{Masad2005,Krumbein1941}:
\begin{equation}
{\Psi_{ellip}} = \sqrt[3]{\frac{d_S \times d_I}{d_L^2}}
\label{eq:sphericity_AIMS}
\end{equation}

% For Equation (32) - Roughness:
Roughness is defined as~\cite{Kuo2000}:
\begin{equation}
{Roughness} = \frac{S_P}{S_C} - 1
\label{eq:roughness}
\end{equation}

% For Equation (33) - Ratio-based angularity index:
The ratio-based angularity index is given by~\cite{Kuo2000}:
\begin{equation}
{AI_{ratio}} = \frac{S_{E,ellip}}{S_C}
\label{eq:AI_ratio}
\end{equation}

% For Equation (34) - Mean deviation-based angularity index:
The mean deviation-based angularity index is computed as~\cite{Masad2000}:
\begin{equation}
{AI_{dev}} = \frac{1}{N}\sum_{i=1}^{N} \frac{|R_i - R_{\text{EE},i}|}{R_{\text{EE},i}}
\label{eq:AI_masad}
\end{equation}
